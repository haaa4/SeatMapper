<Page x:Class="SeatMapper.Setting.ArchivalEditor.Pages.BlacklistTableMate"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SeatMapper.Setting.ArchivalEditor.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BlacklistTableMate">

    <StackPanel>
        <ui:Card HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10">
            <StackPanel>
                <TextBlock Text="     添加同桌黑名单后，在生成座位表时，SeatMapper会避免将黑名单中的同学安排在相邻位置（前后左右斜）。请避免设置过多黑名单，以免影响座位表生成效果。" TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>
        <ui:Card HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox x:Name="Name1" Width="150" HorizontalAlignment="Left" KeyDown="Name1_KeyDown" />
                    <ui:TextBlock Text="与" Margin="5 0 5 0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <ui:TextBox x:Name="Name2" Width="150" HorizontalAlignment="Left" KeyDown="Name2_KeyDown" />
                    <ui:Button Content="添加" Margin="10 0 0 0" Click="AddBlacklistPair_Click" />
                    <ui:Button Content="删除" Margin="10 0 0 0" Click="RemoveBlacklistPair_Click" IsEnabled="False" x:Name="RemoveBlacklistPair" />
                </StackPanel>
                <ui:ListView x:Name="BlacklistListView" MaxHeight="350" ItemsSource="{Binding BlacklistPairs}" Grid.Row="1" SelectionChanged="BlacklistListView_SelectionChanged" />
            </Grid>
        </ui:Card>
    </StackPanel>
</Page>