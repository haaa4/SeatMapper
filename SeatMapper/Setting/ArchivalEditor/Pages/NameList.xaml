<Page
    x:Class="SeatMapper.Setting.ArchivalEditor.Pages.NameList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SeatMapper.Setting.ArchivalEditor.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="NameList"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <ui:Card
            Margin="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <ui:TextBlock
                    Margin="3,3,0,0"
                    FontSize="20"
                    Text="男生名单" />
                <ui:Button
                    x:Name="MaleEditButton"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Click="MaleEditButton_Click"
                    Content="编辑" />
                <ui:TextBlock
                    x:Name="MaleEmptyTextBlock"
                    Grid.Row="1"
                    Margin="10,0,0,0"
                    Text="无" />
                <ui:ListView
                    x:Name="MaleListView"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    MaxHeight="350"
                    ItemsSource="{Binding MaleNames}" />
            </Grid>
        </ui:Card>
        <ui:Card
            Grid.Column="1"
            Margin="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <ui:TextBlock
                    Margin="3,3,0,0"
                    FontSize="20"
                    Text="女生名单" />
                <ui:Button
                    x:Name="FemaleEditButton"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Click="FemaleEditButton_Click"
                    Content="编辑" />
                <ui:TextBlock
                    x:Name="FemaleEmptyTextBlock"
                    Grid.Row="1"
                    Margin="10,0,0,0"
                    Text="无" />
                <ui:ListView
                    x:Name="FemaleListView"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    MaxHeight="350"
                    ItemsSource="{Binding FemaleNames}" />
            </Grid>
        </ui:Card>
        <ui:Card
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="10,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Grid>
                <TextBlock
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Text="点击“编辑”修改名单内容，一行一个名字，修改后按下Ctrl+S保存，返回该页面点击刷新或在主界面初始化" />
            </Grid>
        </ui:Card>
        <ui:Button
            x:Name="RefreshButton"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,20,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Click="RefreshButton_Click"
            Content="刷新"
            Icon="{ui:SymbolIcon Symbol=ArrowCounterclockwise24}" />
    </Grid>
</Page>
