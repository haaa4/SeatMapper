<ui:FluentWindow
    x:Class="SeatMapper.Setting.ArchivalEditor.ArchivalEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SeatMapper.Setting.ArchivalEditor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:SeatMapper.Setting.ArchivalEditor.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" WindowBackdropType="Tabbed" ExtendsContentIntoTitleBar="True"
    Title="档案编辑"
    Width="1000"
    Height="550"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="档案编辑" Icon="{ui:ImageIcon /Image/icon.png}" />
        <ui:NavigationView
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            OpenPaneLength="200"
            PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="学生名单"
                    Icon="{ui:SymbolIcon Symbol=Clipboard24}"
                    TargetPageType="{x:Type pages:NameList}" />
                <ui:NavigationViewItem
                    Content="表格模板"
                    Icon="{ui:SymbolIcon Symbol=Table24}"
                    TargetPageType="{x:Type pages:TableTemplate}" />
                <ui:NavigationViewItem
                    Content="同桌黑名单"
                    Icon="{ui:SymbolIcon Symbol=AppsList24}"
                    TargetPageType="{x:Type pages:BlacklistTableMate}" />
                <ui:NavigationViewItem
                    Content="文字替换"
                    Icon="{ui:SymbolIcon Symbol=TextAdd20}"
                    TargetPageType="{x:Type pages:FixedText}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>