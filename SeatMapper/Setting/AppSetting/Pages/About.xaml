<Page
    x:Class="SeatMapper.Setting.AppSetting.Pages.About"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SeatMapper.Setting.AppSetting.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="About"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid>
            <StackPanel>
                <ui:Image
                    Height="auto"
                    Margin="12"
                    HorizontalAlignment="Left"
                    Source="/Image/海报.png" />
                <Expander Margin="12,0,12,0">
                    <Expander.Header>
                        <StackPanel>
                            <ui:Image
                                Width="30"
                                Height="30"
                                HorizontalAlignment="Left"
                                Source="/Image/icon.png" />
                            <TextBlock FontSize="30" Text="SeatMapper" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <TextBlock Text="V0.2" />
                        <TextBlock Text="Made by Haaa4" />
                    </StackPanel>
                </Expander>
                <Expander Margin="12,0">
                    <Expander.Header>
                        <TextBlock>
                            <Run FontSize="30" Text="关于作者" />
                        </TextBlock>
                    </Expander.Header>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            x:Name="HeadImage"
                            Width="100"
                            Height="100"
                            Margin="20" />
                        <StackPanel Grid.Column="1">
                            <TextBlock TextWrapping="Wrap">
                                <Run FontSize="30" Text="haaa4" />
                                <Run FontSize="20" Text="因为祂永远不会放弃你，永远不会令你沮丧，永远不会抛弃你，永远不会让你哭，永远不会同你道别，永远不会用谎言伤害你。" />
                            </TextBlock>
                            <ui:HyperlinkButton
                                Content="作者B站"
                                Icon="{ui:SymbolIcon Link24}"
                                NavigateUri="https://space.bilibili.com/1440486452" />
                            <ui:HyperlinkButton
                                Content="作者Github"
                                Icon="{ui:SymbolIcon Link24}"
                                NavigateUri="https://github.com/haaa4" />
                        </StackPanel>
                    </Grid>
                </Expander>
                <Expander Margin="12,0">
                    <Expander.Header>
                        <TextBlock>
                            <Run FontSize="30" Text="系列应用" />
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel>
                        <ui:Card HorizontalAlignment="Stretch">
                            <Grid Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" />
                                    <RowDefinition Height="1.5*" />
                                </Grid.RowDefinitions>
                                <Image
                                    x:Name="NameCubeIcon"
                                    Grid.RowSpan="2"
                                    Height="80" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    FontSize="15"
                                    FontWeight="Black"
                                    Text="NameCube" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    Text="点名器-概率或者命中注定？" />
                                <StackPanel
                                    Grid.RowSpan="2"
                                    Grid.Column="2"
                                    VerticalAlignment="Top">
                                    <ui:HyperlinkButton
                                        Content="Github"
                                        Icon="{ui:SymbolIcon Link24}"
                                        NavigateUri="https://github.com/haaa4/NameCube" />
                                    <ui:HyperlinkButton
                                        Content="Gitee"
                                        Icon="{ui:SymbolIcon Link24}"
                                        NavigateUri="https://gitee.com/haaa4/NameCube" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                        <ui:Card HorizontalAlignment="Stretch">
                            <Grid Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" />
                                    <RowDefinition Height="1.5*" />
                                </Grid.RowDefinitions>
                                <Image
                                    Grid.RowSpan="2"
                                    Height="80"
                                    Source="/Image/icon.png" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    FontSize="15"
                                    FontWeight="Black"
                                    Text="SeatMapper" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    Text="生成座位表-基于Excel表格生成座位表" />
                                <StackPanel
                                    Grid.RowSpan="2"
                                    Grid.Column="2"
                                    VerticalAlignment="Top">
                                    <ui:HyperlinkButton
                                        Content="Github"
                                        Icon="{ui:SymbolIcon Link24}"
                                        NavigateUri="https://github.com/haaa4/SeatMapper" />
                                    <ui:HyperlinkButton
                                        Content="Gitee"
                                        Icon="{ui:SymbolIcon Link24}"
                                        NavigateUri="https://gitee.com/haaa4/SeatMapper" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                        <ui:Card HorizontalAlignment="Stretch">
                            <Grid Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" />
                                    <RowDefinition Height="1.5*" />
                                </Grid.RowDefinitions>
                                <Image
                                    Grid.RowSpan="2"
                                    Height="80"
                                    x:Name="DeskSweeperIcon" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    FontSize="15"
                                    FontWeight="Black"
                                    Text="DeskSweeper" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="20,0,0,0"
                                    Text="文件整理-诶🤓👆🏻，您的桌面上又被下载了一个PPT，让我们的清道夫来帮你整理吧" />
                                <StackPanel
                                    Grid.RowSpan="2"
                                    Grid.Column="2"
                                    VerticalAlignment="Top">
                                    <ui:HyperlinkButton
                                        Content="Github"
                                        Icon="{ui:SymbolIcon Link24}"
                                        NavigateUri="https://github.com/haaa4/DeskSweeper" />
                                    <ui:HyperlinkButton
                                        Content="Gitee"
                                        Icon="{ui:SymbolIcon Link24}"
                                        NavigateUri="https://gitee.com/haaa4/DeskSweeper" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </StackPanel>
                </Expander>
                <Expander Margin="12,0">
                    <Expander.Header>
                        <TextBlock>
                            <Run FontSize="30" Text="其他链接" />
                        </TextBlock>
                    </Expander.Header>
                    <StackPanel>
                        <ui:HyperlinkButton
                            Content="Github主页"
                            Icon="{ui:SymbolIcon Link24}"
                            NavigateUri="https://github.com/haaa4/SeatMapper" />
                        <ui:HyperlinkButton
                            Content="Gitee主页"
                            Icon="{ui:SymbolIcon Link24}"
                            NavigateUri="https://gitee.com/haaa4/SeatMapper" />
                        <ui:HyperlinkButton
                            Content="WPF UI"
                            Icon="{ui:SymbolIcon Link24}"
                            NavigateUri="https://github.com/lepoco/wpfui/tree/main" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Grid>
    </Grid>
</Page>