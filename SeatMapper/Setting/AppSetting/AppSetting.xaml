<ui:FluentWindow x:Class="SeatMapper.Setting.AppSetting.AppSetting"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SeatMapper.Setting.AppSetting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:SeatMapper.Setting.AppSetting.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="应用设置"
    Width="1000"
    Height="550" WindowBackdropType="Tabbed" ExtendsContentIntoTitleBar="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="应用设置" Icon="{ui:ImageIcon /Image/icon.png}" />
        <ui:NavigationView
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            OpenPaneLength="200"
            PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="杂项设置"
                    Icon="{ui:SymbolIcon Symbol=Settings24}"
                    TargetPageType="{x:Type pages:MiscellaneousSettings}" />
                <ui:NavigationViewItem
                    Content="关于应用"
                    Icon="{ui:SymbolIcon Symbol=Info24}"
                    TargetPageType="{x:Type pages:About}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
    </ui:FluentWindow>